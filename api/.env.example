# Copie para .env e ajuste. Lista completa e defaults em app/core/config.py.

DATABASE_URL=postgresql+psycopg://contraria:contraria@db:5432/contraria
LOG_LEVEL=INFO

# Bluesky -- conta do bot (use App Password, nunca a senha principal)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SESSION_PATH=data/bluesky.session

# LLM via LiteLLM: usado para redigir o quote post após uma decisão elegível.
# O backend de verificação padrão abaixo é o Jev local.
LLM_MODEL_NAME=openrouter/openai/gpt-5-mini
LLM_API_KEY=
OPENROUTER_API_KEY=
LLM_API_BASE_URL=
# Janela e margem para revisão integral de matérias antes do quote post.
LLM_CONTEXT_WINDOW_TOKENS=400000
LLM_SOURCE_REVIEW_INPUT_BUDGET_TOKENS=320000
LLM_SOURCE_REVIEW_MAX_CHARS=2500000
LLM_SOURCE_REVIEW_MAX_BATCHES=3
# Modelos por papel (opcionais; padrão é LLM_MODEL_NAME)
# LLM_MODEL_PROSECUTOR=
# LLM_MODEL_DEFENDER=
# LLM_MODEL_JUDGE=

# Fontes de evidência
GOOGLE_FACTCHECK_API_KEY=

# Travas de custo (RNF05)
DAILY_LLM_BUDGET_USD=1.0
DAILY_MAX_INTERVENTIONS=20
DAILY_WRITE_POINTS_BUDGET=60
INTERVENTION_WRITE_POINTS=3
INTERVENTION_DRY_RUN=true
TRIAGE_THRESHOLD_RELEVANCE=1.0
TRIAGE_THRESHOLD_BOT=0.8
TRIAGE_THRESHOLD_FALSEHOOD=0.8
WORKER_PIPELINE_BATCH_SIZE=5
PIPELINE_BOT_SCORING_ENABLED=true
PIPELINE_VERIFICATION_ENABLED=true
PIPELINE_INTERVENTION_ENABLED=true
ENABLE_SEMANTIC_CRITIC=true
# A emissão de rótulo é uma ação externa; só habilite após validar o Ozone.
PIPELINE_LABELER_ENABLED=false
PIPELINE_BOT_IGNORE_THRESHOLD=0.9
PIPELINE_MIN_FOLLOWERS_FOR_INTERVENTION=500

# Issue #21: fontes independentes; web_search usa SearXNG e depois DuckDuckGo.
DUCKDUCKGO_ENABLED=true
RSS_CHECKERS_ENABLED=true
WEB_SEARCH_DAYS=7
WEB_CACHE_TTL_SECONDS=3600
WEB_CACHE_MAX_ENTRIES=1000
EVIDENCE_TIMEOUT_SECONDS=20
RSS_POLL_SECONDS=3600
RSS_RECENCY_WEIGHT=0.1
RSS_RECENCY_HALF_LIFE_DAYS=30
RSS_MIN_SIMILARITY=0.3
# JSON: remover um nome desativa sua coleta E seus resultados na busca.
RSS_ENABLED_SOURCES=["lupa","aos_fatos","g1_fato_fake","boatos","comprova","tse"]
# URLs customizadas por fonte; necessário para feeds sem URL confirmada.
RSS_FEED_URLS={}

# Self-RAG (#23). Adicione web_search/rss_checkers quando essas fontes estiverem configuradas.
SELF_RAG_ENABLED_SOURCES=["google_factcheck","wikipedia"]
SELF_RAG_MAX_QUESTIONS=10
SELF_RAG_MAX_EVIDENCE_PER_SOURCE=3
SELF_RAG_MAX_LLM_CALLS=30

# Conformal Risk Control (#25)
CRC_ALPHA=0.05
# Opcional: usa LLM_MODEL_NAME quando vazio.
CRC_MODEL_NAME=

# Backend de verificação local Jev. O Compose sobe um serviço `jev` que mantém
# uma única cópia do modelo em memória; api e worker o acessam por HTTP.
VERIFICATION_BACKEND=jev
JEV_MODEL_REPO=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
JEV_MODEL_FILE=
JEV_N_CTX=512
JEV_N_THREADS=0
JEV_SERVER_URL=http://jev:8100
# Nunca habilite em produção: sem CRC o Jev deve se abster.
JEV_ALLOW_UNCALIBRATED=false

# Ozone Labeler (#16)
OZONE_LABELER_HANDLE=
OZONE_LABELER_APP_PASSWORD=
OZONE_LABELER_DID=
# Repetição de rótulos que o Ozone não aceitou (espera dobra a cada falha, até 1 h)
LABEL_RETRY_INTERVAL_SECONDS=60
LABEL_RETRY_MAX_ATTEMPTS=8
# Health público do Ozone (o que passa pelo túnel), conferido no /admin/overview. Vazio desliga.
OZONE_HEALTH_URL=
# Obrigatórios pelo serviço Ozone no compose de produção.
OZONE_ADMIN_PASSWORD=
OZONE_SIGNING_KEY_HEX=
OZONE_POSTGRES_USER=postgres
OZONE_POSTGRES_PASSWORD=
OZONE_POSTGRES_DB=ozone

# Rótulo provavel-bot em contas (só age com PIPELINE_LABELER_ENABLED=true)
ACCOUNT_LABEL_THRESHOLD=0.9
ACCOUNT_LABEL_HYSTERESIS=0.1
ACCOUNT_LABEL_MIN_POSTS=20

# Fonte citada pelo post (ADR 0019)
CITED_SOURCE_ENTAILMENT_MIN=0.7
CITED_SOURCE_MIN_AUTHORITY=2.0

# Worker: análises simultâneas e teto de fila (ADR 0018). Ajuste à sua máquina.
WORKER_PIPELINE_CONCURRENCY=3
WORKER_QUEUE_MAX_PENDING=100
WORKER_QUEUE_SEARCH_RESERVE=30
WORKER_PIPELINE_MAX_ATTEMPTS=3

# Busca ativa: procura no Bluesky alegações já checadas por fontes confiáveis.
# As consultas fixas cobrem narrativas recorrentes; títulos das checagens recentes
# completam a lista a cada ciclo, sem publicar nada por si só.
FACTCHECK_SEARCH_ENABLED=true
FACTCHECK_SEARCH_STATIC_QUERIES=["urna fraudada","eleição roubada","TSE fraudou","TSE manipulou","resultado das urnas manipulado","voto impresso fraude","STF censurou","Lula vai fechar igrejas"]
FACTCHECK_SEARCH_MAX_ARTICLES=8
FACTCHECK_SEARCH_MAX_QUERIES=16
FACTCHECK_SEARCH_MAX_AGE_DAYS=14
FACTCHECK_SEARCH_PRIORITY_BONUS=25.0
FACTCHECK_SEARCH_RESERVE=20

# Janela de idade dos posts na fila do worker (aging delay).
# Evita checar breaking news antes que notícias maturem e sejam indexadas.
POST_MIN_AGE_HOURS=3.0
POST_MAX_AGE_HOURS=48.0

# Chave de API administrativa para acesso seguro aos endpoints de consulta/logs/banco.
# Deixe vazia para desabilitar o acesso administrativo externo.
ADMIN_API_KEY=

# Resiliência das fontes de evidência (ADR 0021)
EVIDENCE_PROVIDER_TIMEOUT_SECONDS=8
EVIDENCE_FAILURE_COOLDOWN_SECONDS=30
EVIDENCE_FAILURE_COOLDOWN_MAX_SECONDS=600
