# Copie para .env e ajuste. Lista completa e defaults em app/core/config.py.

DATABASE_URL=postgresql+psycopg://contraria:contraria@db:5432/contraria
LOG_LEVEL=INFO

# Bluesky -- conta do bot (use App Password, nunca a senha principal)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# LLM via LiteLLM: "openrouter/<provider>/<model>" ou "ollama/<model>" (local)
LLM_MODEL_NAME=openrouter/google/gemini-2.5-flash
LLM_API_KEY=
LLM_API_BASE_URL=

# Fontes de evidência
GOOGLE_FACTCHECK_API_KEY=
TAVILY_API_KEY=

# Travas de custo (RNF05)
DAILY_LLM_BUDGET_USD=1.0
DAILY_MAX_INTERVENTIONS=20
