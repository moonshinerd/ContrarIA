{
  "openapi": "3.1.0",
  "info": {
    "title": "ContrarIA",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/decisions": {
      "get": {
        "tags": [
          "decisions"
        ],
        "summary": "List Decisions",
        "operationId": "list_decisions_v1_decisions_get",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Action"
            }
          },
          {
            "name": "verdict",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Verdict"
            }
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DecisionLogOut"
                  },
                  "title": "Response List Decisions V1 Decisions Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/decisions/{decision_id}": {
      "get": {
        "tags": [
          "decisions"
        ],
        "summary": "Get Decision",
        "operationId": "get_decision_v1_decisions__decision_id__get",
        "parameters": [
          {
            "name": "decision_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Decision Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionLogOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/analyze": {
      "post": {
        "tags": [
          "decisions"
        ],
        "summary": "Analyze Post",
        "description": "Roda o pipeline sob demanda para uma URL de post do Bluesky.\n\nPor padrão opera em dry-run (não publica). Ideal para demo do showcase.",
        "operationId": "analyze_post_v1_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionLogOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/decisions/{decision_id}/review": {
      "post": {
        "tags": [
          "decisions"
        ],
        "summary": "Review Decision",
        "description": "Registra uma revisão e, quando aplicável, nega o rótulo Ozone.\n\nA decisão original nunca é atualizada: a revisão é um evento separado,\npreservando o requisito de auditoria insert-only.",
        "operationId": "review_decision_v1_decisions__decision_id__review_post",
        "parameters": [
          {
            "name": "decision_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Decision Id"
            }
          },
          {
            "name": "review_action",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Ação: confirmar | reverter",
              "title": "Review Action"
            },
            "description": "Ação: confirmar | reverter"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionReviewOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "infra"
        ],
        "summary": "Health",
        "description": "Liveness: não toca banco, LLM nem Bluesky.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "post_url": {
            "type": "string",
            "title": "Post Url",
            "description": "URL pública do post no Bluesky"
          }
        },
        "type": "object",
        "required": [
          "post_url"
        ],
        "title": "AnalyzeRequest"
      },
      "DecisionLogOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "post_uri": {
            "type": "string",
            "title": "Post Uri"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "post_snapshot": {
            "additionalProperties": true,
            "type": "object",
            "title": "Post Snapshot"
          },
          "bot_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bot Score"
          },
          "bot_features": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bot Features"
          },
          "sources": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sources"
          },
          "agent_outputs": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Outputs"
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verdict"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "crc_threshold_used": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crc Threshold Used"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "justification": {
            "type": "string",
            "title": "Justification"
          }
        },
        "type": "object",
        "required": [
          "id",
          "post_uri",
          "created_at",
          "post_snapshot",
          "action",
          "justification"
        ],
        "title": "DecisionLogOut"
      },
      "DecisionReviewOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "decision_id": {
            "type": "integer",
            "title": "Decision Id"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "justification": {
            "type": "string",
            "title": "Justification"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "decision_id",
          "action",
          "justification",
          "created_at"
        ],
        "title": "DecisionReviewOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
